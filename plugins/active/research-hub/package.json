{
  "name": "@peishenglai3-hash/dsh-research-hub",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified right-sidebar research hub: artifacts, provenance, reviewer and litdb in one entry.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "package.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peishenglai3-hash/dsh-research-mode.git",
    "directory": "plugins/active/research-hub"
  },
  "publishConfig": {
    "access": "public"
  }
}
