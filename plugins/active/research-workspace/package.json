{
  "name": "@peisheng_lai/dsh-research-workspace",
  "version": "0.2.0",
  "type": "module",
  "description": "Phase 1 Host-only Research Workspace page (native sidebar entry + main panel).",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "VERIFY.md",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "package.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peishenglai3-hash/dsh-research-mode.git",
    "directory": "plugins/active/research-workspace"
  },
  "publishConfig": {
    "access": "public"
  }
}
